# Dependencies
node_modules/
.pnpm-store/

# Build output
# Screen Coach's overlay bundles (desktop/scripts/build-shell.mjs)
desktop/shell/gen/
.next/
.next-e2e/
.next-build/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Env files: never commit secrets. Only *.example files are tracked.
.env
.env.*
!.env.example
!**/.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Supabase CLI local state
backend/supabase/.branches/
backend/supabase/.temp/

# Testing
coverage/

# Keys and certificates
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log

# Clerk keyless-mode development keys
.clerk/
.audit-requirements.txt

# Playwright output
test-results/
playwright-report/

# Pyodide runtime, copied from node_modules by frontend/scripts/copy-pyodide.mjs
frontend/public/pyodide/
# transformers.js and ONNX Runtime (Mew v2), copied by frontend/scripts/copy-transformers.mjs
frontend/public/workers/vendor/
# A trained Mew v2 model (ml/README.md: built by training, deployed with the app)
frontend/public/workers/models/
# Mew v2 datasets contain students' words: never commit them
ml/data/
ml/output/

# Eval replies cached by `pnpm eval:notes` (model outputs; never committed)
frontend/evals/.cache/
