# Copy to .env.local at the repo root for local development. Both apps/web and services/api read
# it. Never commit real values. In production, set these in the hosting dashboard instead.
#
# Browser-visible values are prefixed NEXT_PUBLIC_. Everything else is server-only.

# ─── Shared ────────────────────────────────────────────────────────────────────────────────────
# Shared secret between the web server and the API (min 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_SECRET=

# ─── Web (apps/web) ────────────────────────────────────────────────────────────────────────────
APP_ORIGIN=http://localhost:3000
API_BASE_URL=http://127.0.0.1:8000

# Clerk: https://dashboard.clerk.com → API keys (or `npx clerk@latest env pull`).
# Leave blank in development to use Clerk keyless mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase: Project settings → API keys. Use the *publishable* key here (never the secret key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only admin key (bypasses RLS). Not needed until later milestones.
SUPABASE_SECRET_KEY=

# Gemini (M2+). Model IDs are env-configurable; check https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_TUTOR_MODEL=
GEMINI_GATE_MODEL=
GEMINI_EMBED_MODEL=

# ElevenLabs (M2+). Check https://elevenlabs.io/docs for current model IDs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_STT_MODEL=

# ─── API (services/api) ────────────────────────────────────────────────────────────────────────
APP_ENV=development
# Clerk Frontend API URL (the token `iss`), e.g. https://your-app.clerk.accounts.dev
# Shown in the Clerk dashboard under API keys → "Frontend API URL".
CLERK_ISSUER=
# Comma-separated origins allowed in the token `azp` claim.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
