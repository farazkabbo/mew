# Copy to .env.local at the repo root for local development. Both frontend/ and backend/ read
# it. Never commit real values. In production, set these in the hosting dashboard instead.
#
# Browser-visible values are prefixed NEXT_PUBLIC_. Everything else is server-only.

# ─── Shared ────────────────────────────────────────────────────────────────────────────────────
# Shared secret between the web server and the API (min 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_SECRET=

# ─── Frontend (frontend/) ──────────────────────────────────────────────────────────────────────
APP_ORIGIN=http://localhost:3000
API_BASE_URL=http://127.0.0.1:8000

# Clerk: https://dashboard.clerk.com → API keys (or `npx clerk@latest env pull`).
# Leave blank in development to use Clerk keyless mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase: Project settings → API keys. Use the *publishable* key here (never the secret key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only admin key (bypasses RLS). Used only by the API service: course-ingestion jobs (M7),
# for a course whose owner it has just verified (session tokens expire before a long PDF is
# indexed), and desktop sign-in (Screen Coach device tokens, which have no user session).
# Never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Gemini (M2+). Model IDs default to the values shown (checked 2026-10-16); override to swap
# models. Current list: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_GATE_MODEL=gemini-3.5-flash-lite
GEMINI_TUTOR_MODEL=gemini-3.8-flash
# Course retrieval (M7): 768-dimension embeddings. Without a key, a local lexical fallback is used.
GEMINI_EMBED_MODEL=gemini-embedding-2
# Concept extraction and lessons (M7); defaults to GEMINI_TUTOR_MODEL.
GEMINI_COURSE_MODEL=
# Screen Coach answers (desktop app); defaults to GEMINI_TUTOR_MODEL.
GEMINI_SCREEN_MODEL=
# Screen Coach step checks (coach mode): frequent yes/no calls, so a fast model. Also Notes
# Check's second opinion on each difference.
GEMINI_VERIFIER_MODEL=gemini-3.5-flash-lite
# Notes Check comparisons ("check my notes"); defaults to GEMINI_SCREEN_MODEL.
GEMINI_NOTES_MODEL=
# Notes checks a student may run per day (one comparison + up to 5 verifier calls each).
NOTES_CHECKS_PER_DAY=60

# ElevenLabs (M2+). The key stays on the server; browsers get single-use 15-minute tokens.
# Model IDs: https://elevenlabs.io/docs
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# The tutor's default voice (required to speak). On a free ElevenLabs plan use one of
# ElevenLabs' own voices (e.g. George, JBFqnCBsd6RMkjVDRZzb): Voice Library voices need a paid
# plan through the API (every request fails with 402).
ELEVENLABS_VOICE_ID=
# Optional: more voices students can pick in Settings, as Name:voiceId,Name:voiceId.
ELEVENLABS_VOICES=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# ─── Backend (backend/) ─────────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Clerk Frontend API URL (the token `iss`), e.g. https://your-app.clerk.accounts.dev
# Shown in the Clerk dashboard under API keys → "Frontend API URL".
CLERK_ISSUER=
# Comma-separated origins allowed in the token `azp` claim.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Stripe (both frontend and backend) ────────────────────────────────────────────────────────
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=                                # Backend only (secret key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=           # Frontend (publishable key)
STRIPE_WEBHOOK_SECRET=                         # Backend only (webhook signing secret)
STRIPE_PRICE_ID=                               # Your $15/month price ID

# Free tier configuration (session-based limit)
FREE_TIER_SESSION_HOURS=5
FREE_TIER_COOLDOWN_HOURS=5
