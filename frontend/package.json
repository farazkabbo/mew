{
  "name": "@mew/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs && node scripts/copy-transformers.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/copy-pyodide.mjs && node scripts/copy-transformers.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "eval:mew": "tsx --conditions=react-server evals/mew.eval.ts",
    "eval:tutor": "tsx --conditions=react-server evals/tutor.eval.ts",
    "eval:course": "tsx --conditions=react-server evals/course.eval.ts",
    "eval:quiz": "tsx --conditions=react-server evals/quiz.eval.ts",
    "eval:notes": "tsx --conditions=react-server evals/notes-check.eval.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.18",
    "@google/genai": "2.28.0",
    "@huggingface/transformers": "4.3.1",
    "@mew/ink": "workspace:*",
    "@mew/shared": "workspace:*",
    "@supabase/supabase-js": "^2",
    "dexie": "^4.4.6",
    "lucide-react": "^1.55.0",
    "next": "16.4.2",
    "perfect-freehand": "^1.2.3",
    "pyodide": "314.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "ts-fsrs": "5.4.2",
    "zod": "^4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5"
  }
}
