{
  "name": "@mew/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs && node scripts/copy-transformers.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/copy-pyodide.mjs && node scripts/copy-transformers.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "eval:mew": "tsx --conditions=react-server evals/mew.eval.ts",
    "eval:tutor": "tsx --conditions=react-server evals/tutor.eval.ts",
    "eval:course": "tsx --conditions=react-server evals/course.eval.ts",
    "eval:quiz": "tsx --conditions=react-server evals/quiz.eval.ts",
    "eval:notes": "tsx --conditions=react-server evals/notes-check.eval.ts",
    "eval:solution": "tsx --conditions=react-server evals/solution.eval.ts",
    "eval:handwriting": "tsx --conditions=react-server evals/handwriting.eval.ts",
    "eval:tokens": "tsx --conditions=react-server evals/tokens.eval.ts",
    "journey": "playwright test --config playwright.journey.config.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.10.7",
    "@google/genai": "2.26.0",
    "@huggingface/transformers": "4.3.2",
    "@mew/ink": "workspace:*",
    "@mew/shared": "workspace:*",
    "@supabase/supabase-js": "^2",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.41.0",
    "dexie": "^4.4.7",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "perfect-freehand": "^1.2.3",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "ts-fsrs": "5.4.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5"
  }
}
