{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neb",
  "version": "0.1.0",
  "identifier": "app.mew.desktop",
  "build": {
    "frontendDist": "../shell",
    "beforeDevCommand": "pnpm run build:shell",
    "beforeBuildCommand": "pnpm run build:shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http://mewclip.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A quiet tutor that lives in your notebook.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
