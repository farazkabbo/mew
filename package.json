{
  "name": "mew",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mew/frontend --filter @mew/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "health": "tsx scripts/health.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "eval:mew": "pnpm --filter @mew/frontend eval:mew",
    "eval:tutor": "pnpm --filter @mew/frontend eval:tutor",
    "eval:course": "pnpm --filter @mew/frontend eval:course"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^9",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8",
    "vitest": "^5"
  }
}
